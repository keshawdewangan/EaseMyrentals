# ============================================================
# EaseMyRentals - Environment Configuration
# Copy this file to .env and fill in all values before deploy
# NEVER commit .env to git
# ============================================================

# PostgreSQL Database
POSTGRES_DB=easemyrentals
POSTGRES_USER=easemyrentals
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# App Port (dev only — in prod nginx handles public ports)
APP_PORT=8000
PORT=8000
BIND_ADDRESS=0.0.0.0

# Admin Login Credentials — CHANGE THESE BEFORE GOING LIVE
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS
SUPERADMIN_NAME=EaseMyRentals Admin
